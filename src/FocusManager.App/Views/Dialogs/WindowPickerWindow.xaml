<Window x:Class="FocusManager.App.Views.Dialogs.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Icon="/Resources/app.ico"
        Title="从正在运行的程序中选择"
        Width="560"
        Height="440">

    <DockPanel Margin="26,22,26,22">

        <TextBlock DockPanel.Dock="Top"
                   Text="从正在运行的程序中选择"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,6,0,0"
                   Style="{StaticResource SecondaryTextStyle}"
                   TextWrapping="Wrap"
                   Text="这里列出的是现在开着窗口的程序。选中要添加的那个，然后点「用这个」。" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    Content="取消"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="88"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="OnCancelClick" />

            <Button x:Name="ChooseButton"
                    Content="用这个"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    MinWidth="88"
                    Click="OnChooseClick" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom"
                Margin="0,12,0,0"
                Visibility="Collapsed"
                x:Name="EmptyHintBorder">
            <TextBlock x:Name="EmptyHintText"
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap" />
        </Border>

        <Border Margin="0,16,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusCard}"
                Padding="4">
            <ListBox x:Name="WindowListBox"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="{StaticResource RadiusControl}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource SurfaceAltBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource AccentSoftBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding ProcessName}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Title}"
                                       Margin="0,2,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
