<Window x:Class="FocusManager.App.Views.Dialogs.CloseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Icon="/Resources/app.ico"
        Title="关闭程序"
        Width="460"
        SizeToContent="Height">

    <StackPanel Margin="26,22,26,22">
        <TextBlock Text="你希望如何处理 Project Focus Manager？"
                   FontSize="17" FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <Border Height="2" CornerRadius="1" Margin="0,10,0,0"
                Background="{DynamicResource AccentBrush}" />

        <TextBlock Margin="0,14,0,16"
                   Style="{StaticResource MutedTextStyle}"
                   TextWrapping="Wrap"
                   Text="最小化到托盘时，专注计时会照常继续；退出程序则会结束这次运行。" />

        <RadioButton x:Name="TrayOption"
                     Style="{StaticResource ChoiceRadioStyle}"
                     GroupName="CloseChoice"
                     IsChecked="True"
                     Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="最小化到系统托盘" />
                <TextBlock Text="窗口收起来，计时继续，随时可以从托盘图标点回来。"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="ExitOption"
                     Style="{StaticResource ChoiceRadioStyle}"
                     GroupName="CloseChoice">
            <StackPanel>
                <TextBlock Text="退出程序" />
                <TextBlock Text="如果正在专注，会先把这一轮正常结束并保存，然后退出。"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </RadioButton>

        <CheckBox x:Name="RememberCheck"
                  Style="{StaticResource AppCheckBoxStyle}"
                  Margin="0,16,0,0"
                  Content="记住我的选择，下次不再询问" />

        <TextBlock x:Name="HintText"
                   Margin="0,10,0,0"
                   Style="{StaticResource MutedTextStyle}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="取消"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="88"
                    Margin="0,0,10,0"
                    IsCancel="True" />
            <Button x:Name="ConfirmButton"
                    Content="确定"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="88"
                    IsDefault="True"
                    Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
