<Window x:Class="FocusManager.App.Views.Dialogs.ApplicationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Icon="/Resources/app.ico"
        Title="添加学习软件"
        Width="520"
        SizeToContent="Height">

    <StackPanel Margin="26,22,26,22">

        <TextBlock x:Name="HeadingText"
                   Text="添加学习软件"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <TextBlock x:Name="HintText"
                   Margin="0,6,0,0"
                   Style="{StaticResource SecondaryTextStyle}"
                   TextWrapping="Wrap"
                   Text="起一个你认得出的名字，再选它的程序文件（.exe）。" />

        <TextBlock Text="名称"
                   Margin="0,20,0,6"
                   Style="{StaticResource SecondaryTextStyle}" />

        <TextBox x:Name="NameBox" MaxLength="100" />

        <TextBlock Text="程序文件"
                   Margin="0,14,0,6"
                   Style="{StaticResource SecondaryTextStyle}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PathBox" Grid.Column="0" />

            <Button x:Name="BrowseButton"
                    Grid.Column="1"
                    Content="浏览…"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="10,0,0,0"
                    Click="OnBrowseClick" />
        </Grid>

        <TextBlock x:Name="ProcessHintText"
                   Margin="0,8,0,0"
                   Style="{StaticResource MutedTextStyle}"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="ErrorText"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton"
                    Content="取消"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="88"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="OnCancelClick" />

            <Button x:Name="SaveButton"
                    Content="保存"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    MinWidth="88"
                    Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
