<Window x:Class="FocusManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Style="{StaticResource AppWindowStyle}"
        Title="Project Focus Manager"
        Icon="/Resources/app.ico"
        Width="1040"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧导航栏 ==================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource NavRailBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- 产品名称和图标 -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,20,12,22">
                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center">
                        <Path Data="{StaticResource IconFocus}"
                              Stroke="{DynamicResource AccentTextBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="18" Height="18"
                              Stretch="Uniform" />
                    </Border>

                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Project Focus" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Manager" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- 底部：主题切换 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="12,0"
                            Click="OnToggleThemeClick"
                            ToolTip="切换浅色 / 深色">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ThemeIcon"
                                  Data="{StaticResource IconSun}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock x:Name="ThemeText"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource DividerStyle}" Margin="16,10,16,10" />

                <!-- 底部：设置 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,0">
                    <RadioButton x:Name="NavSettings"
                                 GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="OnNavSettingsChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="设置" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 主体导航 -->
                <StackPanel Margin="12,0,12,0">

                    <RadioButton x:Name="NavFocus"
                                 GroupName="Nav"
                                 IsChecked="True"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="OnNavFocusChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFocus}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="专注" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavProjects"
                                 GroupName="Nav"
                                 Margin="0,2,0,0"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="OnNavProjectsChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconProjects}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="项目记录" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavApplications"
                                 GroupName="Nav"
                                 Margin="0,2,0,0"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="OnNavApplicationsChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconApps}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="应用管理" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavIdeas"
                                 GroupName="Nav"
                                 Margin="0,2,0,0"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="OnNavIdeasChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconIdea}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="随手记" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavChat"
                                 GroupName="Nav"
                                 Margin="0,2,0,0"
                                 Style="{StaticResource NavItemStyle}"
                                 ToolTip="在程序里直接用网页版 ChatGPT（默认不加载，点开才启动）"
                                 Checked="OnNavChatChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconChat}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="内置 ChatGPT"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 页面容器 ==================== -->
        <ContentControl Grid.Column="1" x:Name="PageHost" />
    </Grid>
</Window>
