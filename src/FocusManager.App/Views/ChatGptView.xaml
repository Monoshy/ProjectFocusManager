<UserControl x:Class="FocusManager.App.Views.ChatGptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部一条很窄的操作栏：只放状态和两个按钮，不抢网页的地方 -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="内置 ChatGPT"
                               FontSize="{StaticResource FontSizeSection}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="StatusText"
                               Text="网页还没有打开"
                               FontSize="{StaticResource FontSizeMuted}"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReloadButton"
                            Content="重新加载"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="OnReloadClick" />
                    <Button x:Name="CloseWebViewButton"
                            Content="关闭网页"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="关闭网页会释放掉一部分内存，登录状态不会丢"
                            IsEnabled="False"
                            Click="OnCloseWebViewClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 网页容器：只有用户点了「打开」才会往这里放 WebView2 -->
        <Grid Grid.Row="1">
            <Grid x:Name="HostPanel" />

            <ScrollViewer x:Name="PlaceholderPanel"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="{StaticResource ContentMaxWidth}"
                      Margin="32,36,32,40"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="在这里直接用 ChatGPT"
                                   Style="{StaticResource PageTitleTextStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="打开之后就是一个正常的网页，登录、对话都在里面完成。程序不读取、也不保存你的对话内容。"
                                   Style="{StaticResource PageSubtitleTextStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="关于内存"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Text="网页默认不加载。只有你点下面这个按钮时才会启动浏览器内核；点「关闭网页」或离开这一页，程序会把网页关掉、把内存还回去。登录状态保存在本机，下次打开还是登录着的。" />
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Text="需要电脑上装有 WebView2 运行时（Windows 11 一般自带，Windows 10 可能需要装一次）。" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="OpenChatButton"
                                Content="打开 ChatGPT"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center"
                                MinWidth="160"
                                Margin="0,24,0,0"
                                Click="OnOpenClick" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 打开过程中的提示，避免用户以为卡住了 -->
            <Border x:Name="BusyPanel"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="24,18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock Text="正在打开网页…"
                           Style="{StaticResource BodyTextStyle}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
