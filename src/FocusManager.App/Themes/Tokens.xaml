<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        设计令牌（design tokens）。
        这里只放"尺寸"类的固定值：字号、圆角、间距、控件高度。
        颜色不在这里，因为颜色要跟着主题变，放在 Light.xaml / Dark.xaml 里。

        修改界面观感时，优先改这里，而不是去各个页面里改数字。
    -->

    <!-- ==================== 间距刻度 ==================== -->
    <!-- 全项目只允许用这几个数：8 / 12 / 16 / 24 / 32 -->
    <sys:Double x:Key="SpaceXS">8</sys:Double>
    <sys:Double x:Key="SpaceS">12</sys:Double>
    <sys:Double x:Key="SpaceM">16</sys:Double>
    <sys:Double x:Key="SpaceL">24</sys:Double>
    <sys:Double x:Key="SpaceXL">32</sys:Double>

    <!-- 常用边距（Margin / Padding 用 Thickness） -->
    <Thickness x:Key="PagePadding">32,28,32,32</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="DialogPadding">24</Thickness>

    <!-- ==================== 圆角 ==================== -->
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ==================== 字号 ==================== -->
    <sys:Double x:Key="FontSizePageTitle">26</sys:Double>
    <sys:Double x:Key="FontSizeSection">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption">13</sys:Double>
    <sys:Double x:Key="FontSizeMuted">12</sys:Double>
    <sys:Double x:Key="FontSizeTimer">72</sys:Double>
    <sys:Double x:Key="FontSizeBigNumber">24</sys:Double>

    <!-- ==================== 控件尺寸 ==================== -->
    <sys:Double x:Key="ControlHeight">36</sys:Double>
    <sys:Double x:Key="BigButtonHeight">44</sys:Double>
    <sys:Double x:Key="NavRailWidth">200</sys:Double>
    <sys:Double x:Key="ContentMaxWidth">760</sys:Double>

</ResourceDictionary>
