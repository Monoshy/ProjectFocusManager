<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        图标全部用矢量路径自己画，不引入图标字体、不引入图标包、不放图片文件。
        好处：跟着主题变色、任何 DPI 都清晰、几乎不占内存。
        画布统一按 24×24 设计，使用时用 Path 的 Width/Height + Stretch 缩放。
        用法：<Path Data="{StaticResource IconFocus}" Stroke="..." StrokeThickness="1.6" />
    -->

    <!-- 专注（秒表） -->
    <PathGeometry x:Key="IconFocus"
                  Figures="M9.5,2.2 L14.5,2.2 M12,2.2 L12,4.4 M12,4.4 A8,8 0 1 1 11.99,4.4 M12,12.4 L12,8.2 M12,12.4 L15.2,14.2" />

    <!-- 项目记录（列表） -->
    <PathGeometry x:Key="IconProjects"
                  Figures="M8.5,6 L20,6 M8.5,12 L20,12 M8.5,18 L20,18 M4.2,6 L4.21,6 M4.2,12 L4.21,12 M4.2,18 L4.21,18" />

    <!-- 应用管理（四个方格） -->
    <PathGeometry x:Key="IconApps"
                  Figures="M4.5,4.5 L10,4.5 L10,10 L4.5,10 Z M14,4.5 L19.5,4.5 L19.5,10 L14,10 Z M4.5,14 L10,14 L10,19.5 L4.5,19.5 Z M14,14 L19.5,14 L19.5,19.5 L14,19.5 Z" />

    <!-- 设置（滑杆） -->
    <PathGeometry x:Key="IconSettings"
                  Figures="M4,6.5 L20,6.5 M4,12 L20,12 M4,17.5 L20,17.5 M8,4.5 L8,8.5 M15,10 L15,14 M10,15.5 L10,19.5" />

    <!-- 随手记（便签） -->
    <PathGeometry x:Key="IconIdea"
                  Figures="M6,3.5 L18,3.5 A1.5,1.5 0 0 1 19.5,5 L19.5,19 A1.5,1.5 0 0 1 18,20.5 L6,20.5 A1.5,1.5 0 0 1 4.5,19 L4.5,5 A1.5,1.5 0 0 1 6,3.5 M8,8.5 L16,8.5 M8,12 L16,12 M8,15.5 L12.5,15.5" />

    <!-- 内置 ChatGPT（对话气泡） -->
    <PathGeometry x:Key="IconChat"
                  Figures="M4.5,5.5 L19.5,5.5 A1.5,1.5 0 0 1 21,7 L21,15.5 A1.5,1.5 0 0 1 19.5,17 L10.5,17 L6.5,20.5 L6.5,17 L4.5,17 A1.5,1.5 0 0 1 3,15.5 L3,7 A1.5,1.5 0 0 1 4.5,5.5" />

    <!-- 加号 -->
    <PathGeometry x:Key="IconPlus" Figures="M12,5 L12,19 M5,12 L19,12" />

    <!-- 勾 -->
    <PathGeometry x:Key="IconCheck" Figures="M5,12.5 L10,17.5 L19,7" />

    <!-- 下拉箭头 -->
    <PathGeometry x:Key="IconChevronDown" Figures="M6,9.5 L12,15.5 L18,9.5" />

    <!-- 暂停（两条竖线） -->
    <PathGeometry x:Key="IconPause" Figures="M9,6 L9,18 M15,6 L15,18" />

    <!-- 结束（方块） -->
    <PathGeometry x:Key="IconStop" Figures="M7,7 L17,7 L17,17 L7,17 Z" />

    <!-- 继续（三角） -->
    <PathGeometry x:Key="IconPlay" Figures="M8,5.5 L18,12 L8,18.5 Z" />

    <!-- 文件夹 -->
    <PathGeometry x:Key="IconFolder"
                  Figures="M3.5,6.5 A1.5,1.5 0 0 1 5,5 L9.5,5 L11.5,7.5 L19,7.5 A1.5,1.5 0 0 1 20.5,9 L20.5,18 A1.5,1.5 0 0 1 19,19.5 L5,19.5 A1.5,1.5 0 0 1 3.5,18 Z" />

    <!-- 备份（向下箭头到托盘） -->
    <PathGeometry x:Key="IconBackup"
                  Figures="M12,4 L12,15 M7.5,10.5 L12,15 L16.5,10.5 M4.5,18.5 L19.5,18.5" />

    <!-- 太阳 -->
    <PathGeometry x:Key="IconSun"
                  Figures="M12,8 A4,4 0 1 1 11.99,8 M12,2.5 L12,5 M12,19 L12,21.5 M2.5,12 L5,12 M19,12 L21.5,12" />

    <!-- 月亮 -->
    <PathGeometry x:Key="IconMoon"
                  Figures="M20,14.5 A8.5,8.5 0 1 1 9.5,4 A7,7 0 0 0 20,14.5" />

</ResourceDictionary>
