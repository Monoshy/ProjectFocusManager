<Window x:Class="FocusManager.App.Views.Dialogs.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/app.ico"
        Background="{DynamicResource SurfaceBrush}"
        Title="上次的专注没有正常结束"
        Width="520"
        SizeToContent="Height">

    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="上次的专注没有正常结束" FontSize="20" FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap">
            <Run Text="项目：" />
            <Run x:Name="ProjectNameRun" FontWeight="SemiBold" />
        </TextBlock>

        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="程序上次没有正常关闭（比如断电、崩溃，或者被强制结束）。关闭期间的时间不会被算进专注时间，已经保存的记录都还在。" />

        <!-- 已经保存下来的部分 -->
        <Border Margin="0,18,0,0" Padding="16,14"
                CornerRadius="{StaticResource RadiusCard}"
                Background="{DynamicResource SurfaceAltBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="已经保存的专注时间"
                           Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="开始时间"
                           Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SavedText"
                           FontFamily="{DynamicResource TimerFontFamily}"
                           FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"
                           Foreground="{DynamicResource FocusBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StartedText"
                           FontSize="13" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock x:Name="ExtraText"
                   Style="{StaticResource MutedTextStyle}"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,16,0,0" TextWrapping="Wrap"
                   Text="「结束这一轮」会把已经保存的时间记进项目，然后回到主界面；「继续这一轮」会从现在接着往下计时。" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="ResumeButton" Content="继续这一轮" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0" Click="OnResumeClick" />
            <Button x:Name="FinishButton" Content="结束这一轮" Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" Click="OnFinishClick" />
        </StackPanel>
    </StackPanel>
</Window>
