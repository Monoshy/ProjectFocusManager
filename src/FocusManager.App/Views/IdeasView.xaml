<UserControl x:Class="FocusManager.App.Views.IdeasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="840" d:DesignHeight="720">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="{StaticResource ContentMaxWidth}"
              Margin="32,36,32,40"
              HorizontalAlignment="Stretch">

            <StackPanel>

                <TextBlock Text="随手记" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="专注时突然想到别的事，先记在这里，不用马上去处理。"
                           Style="{StaticResource PageSubtitleTextStyle}"
                           Margin="0,6,0,0" />

                <!-- ==================== 记一笔 ==================== -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,22,0,0">
                    <StackPanel>

                        <TextBlock Text="记到哪个项目？" Style="{StaticResource SectionTitleTextStyle}" />

                        <ComboBox x:Name="ProjectComboBox"
                                  Margin="0,10,0,0"
                                  ItemsSource="{Binding Projects}"
                                  SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />

                        <TextBlock Text="想到什么就写一句，不用整理。"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,16,0,0" />

                        <TextBox x:Name="IdeaInputBox"
                                 Style="{StaticResource AppTextAreaStyle}"
                                 Margin="0,8,0,0"
                                 MinHeight="72"
                                 MaxHeight="150"
                                 MaxLength="1000"
                                 Text="{Binding NewIdeaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnIdeaInputKeyDown" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="按 Ctrl+Enter 可以直接保存"
                                       Style="{StaticResource MutedTextStyle}"
                                       VerticalAlignment="Center" />

                            <Button x:Name="AddIdeaButton"
                                    Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110"
                                    IsEnabled="{Binding CanAdd}"
                                    Click="OnAddIdeaClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="记下来" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ==================== 筛选 + 列表 ==================== -->
                <Grid Margin="0,26,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="FilterComboBox"
                              Width="120"
                              ItemsSource="{Binding Filters}"
                              SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding SummaryText}"
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 一个项目都没有的时候 -->
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="{StaticResource RadiusCard}"
                        Padding="18,16"
                        Visibility="{Binding HasNoProjects, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="还没有项目。先到「专注」页新建一个项目，随手记才能记到它下面。"
                               Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- 空列表 -->
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="{StaticResource RadiusCard}"
                        Padding="18,16"
                        Visibility="{Binding HasNoIdeas, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="这个项目还没有记过想法。"
                               Style="{StaticResource SecondaryTextStyle}" />
                </Border>

                <ItemsControl ItemsSource="{Binding Ideas}"
                              Visibility="{Binding HasIdeas, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}"
                                    Padding="16,14"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource FocusBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding TimeText}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Text="· 专注中记下"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding FromFocusSession, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <TextBox Text="{Binding Content, Mode=OneWay}"
                                                 Margin="0,6,0,0">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource ReadOnlyTextStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <TextBlock Text="{Binding DoneAtText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding HasDoneAt, Converter={StaticResource BoolToVisibility}}" />

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top"
                                                Margin="16,0,0,0">
                                        <Button Content="{Binding ToggleText}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                MinWidth="92"
                                                Click="OnToggleClick" />
                                        <Button Content="删除"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                MinWidth="56"
                                                Margin="6,0,0,0"
                                                Click="OnDeleteClick" />
                                    </StackPanel>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
