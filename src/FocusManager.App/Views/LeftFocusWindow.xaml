<Window x:Class="FocusManager.App.Views.LeftFocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="Manual"
        Background="{DynamicResource SurfaceBrush}"
        Icon="/Resources/app.ico"
        Title="专注提醒"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowActivated="True"
        Topmost="True">

    <StackPanel Margin="26,22,26,22">

        <TextBlock x:Name="TitleText"
                   Text="你似乎离开了当前学习环境"
                   FontSize="17" FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <Border Height="2" CornerRadius="1" Margin="0,10,0,0"
                Background="{DynamicResource PauseBrush}" />

        <TextBlock x:Name="MessageText"
                   Margin="0,14,0,0"
                   Style="{StaticResource BodyTextStyle}"
                   TextWrapping="Wrap"
                   Text="刚才那个窗口不在本轮的专注环境里。计时还在继续，要不要暂停由你自己决定。" />

        <!-- 第一步：返回项目 / 确认切换 -->
        <StackPanel x:Name="FirstStepPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="SwitchButton"
                    Content="确认切换"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="96"
                    Margin="0,0,10,0"
                    Click="OnSwitchClick" />

            <Button x:Name="ReturnButton"
                    Content="返回项目"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="96"
                    IsDefault="True"
                    Click="OnReturnClick" />
        </StackPanel>

        <!-- 第二步：暂停 / 结束 -->
        <StackPanel x:Name="SecondStepPanel" Visibility="Collapsed" Margin="0,18,0,0">
            <TextBlock Text="这一轮要怎么办？"
                       Style="{StaticResource SecondaryTextStyle}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BackButton"
                        Content="先不决定"
                        Style="{StaticResource GhostButtonStyle}"
                        MinWidth="88"
                        Margin="0,0,10,0"
                        Click="OnBackClick" />

                <Button x:Name="PauseButton"
                        Content="暂停本次专注"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="112"
                        Margin="0,0,10,0"
                        Click="OnPauseClick" />

                <Button x:Name="FinishButton"
                        Content="结束本次专注"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="112"
                        Click="OnFinishClick" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
