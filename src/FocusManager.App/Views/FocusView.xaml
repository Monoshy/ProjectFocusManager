<UserControl x:Class="FocusManager.App.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="840">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="{StaticResource ContentMaxWidth}"
              Margin="32,36,32,40"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center">

            <!-- ============ 空闲状态：准备开始 ============ -->
            <StackPanel Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="开始一次专注" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Margin="0,8,0,28"
                           Text="选一个项目，选本轮主要用的学习软件，然后开始。计时会一直往上走，不设上限。" />

                <!-- 选项目 -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="这次专注哪个项目？" Style="{StaticResource SectionTitleTextStyle}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ProjectComboBox"
                                      Grid.Column="0"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      ItemsSource="{Binding Projects}"
                                      SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                      DisplayMemberPath="Name" />

                            <Button x:Name="NewProjectButton" Grid.Column="1" Margin="10,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnNewProjectClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="新建项目" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0"
                                   Text="{Binding SelectedProjectTotalText}" />

                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"
                                   Text="列表里还没有项目？点右边的「新建项目」，输入名字就行。"
                                   Visibility="{Binding HasNoProjects, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 选应用 -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock Text="本轮主要使用哪个学习软件？" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,12"
                                   Text="这一项可以稍后再完善。现在先选一个，不影响计时。" />

                        <ComboBox x:Name="ApplicationComboBox"
                                  Style="{StaticResource AppComboBoxStyle}"
                                  ItemsSource="{Binding Applications}"
                                  SelectedItem="{Binding SelectedApplication, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>
                </Border>

                <!-- 本轮辅助程序 -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,28">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="还要一起用哪些程序？（可选）"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />

                            <Button x:Name="AddAuxiliaryButton"
                                    Grid.Column="1"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="OnAddAuxiliaryClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="添加辅助程序" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding AuxiliaryEmptyHint}"
                                   Visibility="{Binding HasAuxiliaryApplications, Converter={StaticResource InverseBoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding AuxiliaryApplications}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            CornerRadius="{StaticResource RadiusControl}"
                                            Padding="10,5"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Margin="6,0,0,0"
                                                    Padding="4"
                                                    ToolTip="从本轮移除"
                                                    Click="OnRemoveAuxiliaryClick">
                                                <Path Data="{StaticResource IconStop}"
                                                      Stroke="{DynamicResource TextMutedBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeLineJoin="Round"
                                                      Width="9" Height="9"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Button x:Name="StartFocusButton"
                        Content="开始专注"
                        Style="{StaticResource BigActionButtonStyle}"
                        HorizontalAlignment="Center"
                        IsEnabled="{Binding CanStart}"
                        Click="OnStartClick" />
            </StackPanel>

            <!-- ============ 运行 / 暂停状态 ============ -->
            <StackPanel VerticalAlignment="Top" Margin="0,24,0,0"
                        Visibility="{Binding IsIdle, Converter={StaticResource InverseBoolToVisibility}}">

                <!-- 当前项目 -->
                <TextBlock Text="{Binding CurrentProjectName}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />

                <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0"
                           Style="{StaticResource SecondaryTextStyle}">
                    <Run Text="本轮主要软件：" />
                    <Run Text="{Binding CurrentApplicationName, Mode=OneWay}" />
                </TextBlock>

                <!-- 辅助程序：专注中也能补一个进来，不用重新开始 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasAuxiliaryApplications, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="辅助程序：" />
                        <Run Text="{Binding AuxiliarySummaryText, Mode=OneWay}" />
                    </TextBlock>

                    <Button x:Name="AddAuxiliaryRunningButton"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="8,0,0,0"
                            Padding="8,2"
                            Click="OnAddAuxiliaryClick"
                            ToolTip="再补一个程序进来，不用重新开始这一轮">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="11" Height="11"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="添加" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 计时数字：整个页面的视觉中心 -->
                <TextBlock x:Name="TimerTextBlock"
                           Text="{Binding ElapsedText}"
                           Margin="0,32,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TimerTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PauseBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 状态小胶囊 -->
                <Border Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
                            <Setter Property="Background" Value="{DynamicResource FocusSoftBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PauseSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource FocusBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource PauseBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock x:Name="StateText" Text="{Binding StateText}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource FocusBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource PauseBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding PausedText}" HorizontalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" />

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">

                    <Button x:Name="PauseButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="OnPauseClick"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPause}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="暂停一下" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ResumeButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="OnResumeClick"
                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  StrokeLineJoin="Round"
                                  Width="12" Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="继续专注" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="FinishButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="{DynamicResource DangerBrush}"
                            Click="OnFinishClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconStop}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="结束本次专注" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 作废：这一轮不算数，直接丢掉，不留记录 -->
                    <Button x:Name="DiscardButton"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="{DynamicResource DangerBrush}"
                            Margin="10,0,0,0"
                            Click="OnDiscardClick"
                            ToolTip="这一轮不算数：不记录时间，也不留下这条记录">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="12" Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="作废本轮" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 随手记：专注中想到别的事，先记下来，不用离开 -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,26,0,0">
                    <StackPanel>
                        <TextBlock Text="突然想到什么？先记一句，不用离开。"
                                   Style="{StaticResource MutedTextStyle}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="QuickIdeaBox"
                                     Style="{StaticResource AppTextAreaStyle}"
                                     MinHeight="56"
                                     MaxHeight="120"
                                     MaxLength="1000"
                                     KeyDown="OnQuickIdeaKeyDown"
                                     TextChanged="OnQuickIdeaTextChanged" />

                            <Button x:Name="QuickIdeaButton"
                                    Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="96"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Click="OnQuickIdeaClick"
                                    Content="记下来" />
                        </Grid>

                        <TextBlock x:Name="QuickIdeaHint"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 项目累计 -->
                <TextBlock Text="{Binding ActiveProjectTotalText}"
                           HorizontalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,28,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
