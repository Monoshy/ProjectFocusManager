<Window x:Class="FocusManager.App.Views.Dialogs.ApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Icon="/Resources/app.ico"
        Title="添加辅助程序"
        Width="600"
        Height="560">

    <DockPanel Margin="26,22,26,22">

        <TextBlock DockPanel.Dock="Top"
                   Text="添加辅助程序"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,6,0,0"
                   Style="{StaticResource SecondaryTextStyle}"
                   TextWrapping="Wrap"
                   Text="选一个这一轮要一起用的程序。已经加过的会标出来，不会重复添加。" />

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,14,0,6"
                   Style="{StaticResource MutedTextStyle}"
                   Text="按名字或进程名筛选（可以留空）" />

        <TextBox DockPanel.Dock="Top"
                 x:Name="SearchBox"
                 Style="{StaticResource AppTextBoxStyle}"
                 TextChanged="OnSearchTextChanged"
                 ToolTip="按名字或进程名筛选" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    Content="取消"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="88"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="OnCancelClick" />

            <Button x:Name="AddButton"
                    Content="加进来"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    MinWidth="88"
                    Click="OnAddClick" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="FromWindowButton"
                    Content="从正在运行的程序里挑…"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="OnFromWindowClick" />

            <Button x:Name="NewApplicationButton"
                    Content="新建应用…"
                    Style="{StaticResource GhostButtonStyle}"
                    Margin="8,0,0,0"
                    Click="OnNewApplicationClick" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom"
                Margin="0,12,0,0"
                Visibility="Collapsed"
                x:Name="EmptyHintBorder">
            <TextBlock x:Name="EmptyHintText"
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap" />
        </Border>

        <Border Margin="0,16,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusCard}"
                Padding="4">
            <ListBox x:Name="ApplicationListBox"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnListSelectionChanged"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="{StaticResource RadiusControl}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource SurfaceAltBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource AccentSoftBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding ProcessText}"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="已经加过"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Visibility="{Binding AlreadyAdded, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
