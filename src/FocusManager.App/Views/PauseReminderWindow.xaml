<Window x:Class="FocusManager.App.Views.PauseReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="该回来了"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}"
        Icon="/Resources/app.ico">

    <StackPanel Margin="26,22,26,22">
        <TextBlock x:Name="TitleText"
                   Text="你已经暂停一段时间了，准备回来了吗？"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap" />

        <Border x:Name="AccentBar"
                Height="2"
                CornerRadius="1"
                Margin="0,12,0,0"
                Background="{DynamicResource PauseBrush}"
                HorizontalAlignment="Left"
                Width="64" />

        <TextBlock x:Name="MessageText"
                   Margin="0,14,0,0"
                   Style="{StaticResource BodyTextStyle}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button x:Name="FinishButton"
                    Content="结束本次专注"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="112"
                    Margin="0,0,10,0"
                    Click="OnFinishClick" />
            <Button x:Name="ResumeButton"
                    Content="回到项目"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="96"
                    IsDefault="True"
                    Click="OnResumeClick" />
        </StackPanel>
    </StackPanel>
</Window>
