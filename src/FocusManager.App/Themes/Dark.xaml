<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        深色主题。
        注意：不是把浅色简单反转。深色下背景更黑、卡片略亮，
        强调色提亮并降低饱和，正文不用纯白（#ECEDEF）以减少刺眼。
    -->

    <!-- ==================== 背景层次 ==================== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#16171A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1F23" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#26272C" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#121316" />
    <SolidColorBrush x:Key="NavRailBrush" Color="#1A1B1F" />

    <!-- ==================== 线条 ==================== -->
    <SolidColorBrush x:Key="DividerBrush" Color="#2C2E34" />
    <SolidColorBrush x:Key="LineBrush" Color="#2C2E34" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#33353C" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4D55" />

    <!-- ==================== 文字 ==================== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEDEF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8ADB6" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7C828C" />

    <!-- ==================== 强调色 ==================== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#8B9DF5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A0B0FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#7A8CE8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#232842" />
    <!-- 深色主题的强调色偏亮，上面要用深色字才看得清 -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#14161B" />

    <!-- ==================== 状态色 ==================== -->
    <SolidColorBrush x:Key="FocusBrush" Color="#5FD3A0" />
    <SolidColorBrush x:Key="FocusSoftBrush" Color="#16302A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#5FD3A0" />
    <SolidColorBrush x:Key="PauseBrush" Color="#E8A657" />
    <SolidColorBrush x:Key="PauseSoftBrush" Color="#33270F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F08A8A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1F1F" />

    <!-- ==================== 交互叠加层 ==================== -->
    <!-- 深色主题下悬停用白色低透明度，才看得见 -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#24FFFFFF" />

    <!-- ==================== 字体 ==================== -->
    <FontFamily x:Key="UiFontFamily">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="TimerFontFamily">Consolas, Microsoft YaHei UI</FontFamily>

</ResourceDictionary>
