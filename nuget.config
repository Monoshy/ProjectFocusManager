<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 本机 dotnet 直连 nuget.org 会 TLS 被断（NU1301），改为：
         1) 优先用项目内本地包源（.tools/local-packages，用 curl 手工下载的 nupkg）；
         2) 回退 nuget.azure.cn 镜像。
         新增依赖时若两个源都失败，用 curl 从
         https://api.nuget.org/v3-flatcontainer/{id}/{version}/{id}.{version}.nupkg
         下载后放进 .tools/local-packages 即可。 -->
    <clear />
    <add key="local-packages" value=".tools\local-packages" />
  </packageSources>
</configuration>
